.env
.env.prod

# Front
frontend/node_modules/
frontend/dist/

# Editors / OS
.idea/
# Ignore the folder's content, not the folder itself: Git never looks inside
# an ignored folder, so the exceptions below would not apply.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Rover
.rover/

# Secrets (JWT keys...)
secrets/
# Windows and Office leftovers
*:Zone.Identifier
~$*
