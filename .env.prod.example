# Production secrets: copy this file to .env.prod on the server and fill it in.
# .env.prod is never committed.
# The JWT keys are not set here: put private.pem and public.pem in secrets/jwt/ on the server.

# Domain name in production, without https:// (Caddy gets the HTTPS certificate for it).
# Use ":80" for a local test, with FRONTEND_URL=http://localhost.
SITE_ADDRESS=:80

# Generate each password with: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
APP_DB_PASSWORD=

# One key per service, generate each with: echo "base64:$(openssl rand -base64 32)"
AUTH_APP_KEY=
PLANNING_APP_KEY=
PAYROLL_APP_KEY=

# Public address of the app, used in the links sent by email.
FRONTEND_URL=https://heures.ton-domaine.fr

# Transactional email provider. All of these are required, the stack won't start
# if one is empty (use placeholder values for a local test).
# MAIL_FROM_ADDRESS must belong to the domain verified with the provider (SPF, DKIM).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@ton-domaine.fr
MAIL_FROM_NAME=Mes heures

# Contact shown on the privacy page. Built into the frontend:
# rebuild the web image after changing it.
PRIVACY_CONTACT=contact@ton-domaine.fr

# Who may create an account: invite (only people invited by an admin), open or closed.
REGISTRATION_MODE=invite