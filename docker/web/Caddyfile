# Entry point of the app: serves the front end and forwards /auth and /graphql to the services.
# Every company has its own subdomain (dupont.ton-domaine.fr), with an HTTPS certificate
# Caddy gets on its first visit, once auth-service confirms the company exists.
{
	on_demand_tls {
		ask http://auth-service:8000/internal/tls-allowed
	}
}

https:// {
	tls {
		on_demand
	}

	encode zstd gzip

	# Session endpoints (sign-in, refresh, sign-out), which set the refresh cookie.
	# Caddy adds X-Forwarded-Host itself: the services read the company from it.
	handle /auth/* {
		reverse_proxy auth-service:8000
	}

	# The router serves GraphQL on "/", not on "/graphql".
	handle /graphql {
		rewrite * /
		reverse_proxy router:4000
	}

	# /internal (the certificate check) is never forwarded: it falls here and gets the front end.
	handle {
		root * /srv

		# Vite puts a hash in the asset file names, so they can be cached forever.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# React Router handles the URLs: unknown paths get index.html.
		try_files {path} /index.html
		file_server
	}
}